NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000
ANTHROPIC_API_KEY=sk-ant-xxx

# Marketing contact form (/api/contact). Without RESEND_API_KEY the form shows
# an "email us instead" error. CONTACT_FROM must be a Resend-verified sender.
RESEND_API_KEY=
CONTACT_TO=support@advertix.io
CONTACT_FROM=Advertix <noreply@advertix.io>
# Cal.com event for "Book a demo" (e.g. advertix/demo). Unset = request form.
NEXT_PUBLIC_CAL_LINK=

DATABASE_URL=postgresql://postgres:password@localhost:5432/advertix
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
ANTHROPIC_API_KEY=sk-ant-replace_me

# Meta Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:4000/api/meta/callback

# Google Ads API
# - CLIENT_ID / CLIENT_SECRET come from Google Cloud Console â†’ APIs & Services â†’ Credentials
# - DEVELOPER_TOKEN comes from Google Ads â†’ Tools & Settings â†’ API Center (requires Google Ads account)
# - REDIRECT_URI must be whitelisted in your Google OAuth client (Authorized redirect URIs)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token

# TikTok Marketing API
# - APP_ID / APP_SECRET come from https://business-api.tiktok.com/portal â†’ My Apps
# - REDIRECT_URI must be whitelisted on the TikTok app's Auth tab
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_REDIRECT_URI=http://localhost:4000/api/tiktok/callback

# LinkedIn Marketing API
# - CLIENT_ID / CLIENT_SECRET come from https://www.linkedin.com/developers/apps â†’ Auth tab
# - REDIRECT_URI must be added to the LinkedIn app's "Authorized redirect URLs"
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/linkedin/callback

# AES-256-CBC key for encrypting ad-platform access tokens at rest.
# Any string is fine â€” we hash it to 32 bytes via SHA-256 at runtime.
# Generate a strong one with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_random_hex_chars

# Frontend URL used by OAuth callbacks for the post-connect redirect.
FRONTEND_URL=http://localhost:3000

PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

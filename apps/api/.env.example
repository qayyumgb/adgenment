DATABASE_URL=postgresql://postgres:password@localhost:5432/adgenius
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
ANTHROPIC_API_KEY=sk-ant-replace_me

# Meta Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:4000/api/meta/callback

# Google Ads API
# - CLIENT_ID / CLIENT_SECRET come from Google Cloud Console → APIs & Services → Credentials
# - DEVELOPER_TOKEN comes from Google Ads → Tools & Settings → API Center (requires Google Ads account)
# - REDIRECT_URI must be whitelisted in your Google OAuth client (Authorized redirect URIs)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token

# AES-256-CBC key for encrypting ad-platform access tokens at rest.
# Any string is fine — we hash it to 32 bytes via SHA-256 at runtime.
# Generate a strong one with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_random_hex_chars

# Frontend URL used by OAuth callbacks for the post-connect redirect.
FRONTEND_URL=http://localhost:3000

PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

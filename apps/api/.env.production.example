# Advertix API â€” production env template
# -----------------------------------------------------------------------------
# Copy these into Railway â†’ Variables. NEVER commit real secrets here.
# Placeholder values only. See docs/DEPLOY.md for where to obtain each one.

# === Database (Supabase) ===
# Use the SESSION pooler URL on port 5432 for Prisma. The PgBouncer pooler at
# port 6543 also works (append ?pgbouncer=true&connection_limit=1).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# === Clerk (Production instance) ===
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# === Anthropic Claude ===
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# === Token encryption (AES-256-CBC) ===
# Any sufficiently random string. The crypto module SHA-256s this to derive
# the 32-byte AES key, so 32+ chars of entropy is plenty. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# === Server ===
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=https://your-app.vercel.app
# Used by OAuth callbacks to redirect the popup back to the SPA.
FRONTEND_URL=https://your-app.vercel.app
# Legacy alias kept for backwards-compat (read in apps/api/src/index.ts).
WEB_ORIGIN=https://your-app.vercel.app

# === Meta Marketing API ===
META_APP_ID=REPLACE_ME
META_APP_SECRET=REPLACE_ME
META_REDIRECT_URI=https://your-api.railway.app/api/meta/callback

# === Google Ads API ===
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://your-api.railway.app/api/google/callback
# Required for Google Ads API calls â€” not needed for OAuth alone.
GOOGLE_DEVELOPER_TOKEN=REPLACE_ME

# === TikTok Marketing API ===
TIKTOK_APP_ID=REPLACE_ME
TIKTOK_APP_SECRET=REPLACE_ME
TIKTOK_REDIRECT_URI=https://your-api.railway.app/api/tiktok/callback

# === LinkedIn Marketing API ===
LINKEDIN_CLIENT_ID=REPLACE_ME
LINKEDIN_CLIENT_SECRET=REPLACE_ME
LINKEDIN_REDIRECT_URI=https://your-api.railway.app/api/linkedin/callback

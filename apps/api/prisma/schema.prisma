generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  META
  GOOGLE
  TIKTOK
  LINKEDIN
  YOUTUBE
  SNAPCHAT
  PINTEREST
  X
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

/// Team roles (plan B6, decision 7). Owner: everything. Media buyer: runs
/// campaigns, creatives, audiences, connections. Analyst: sees and exports
/// everything, changes nothing. Client viewer: read-only, own clients only.
enum WorkspaceRole {
  OWNER
  MEDIA_BUYER
  ANALYST
  CLIENT_VIEWER
  /// Legacy values, no longer assigned: scripts/migrate-roles.ts moves rows off
  /// them (ADMIN / EDITOR → MEDIA_BUYER, VIEWER → ANALYST). Kept so the push
  /// never has to drop enum values; read as their new equivalents.
  ADMIN
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum BudgetType {
  DAILY
  LIFETIME
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  TEXT
}

enum CreativeStatus {
  DRAFT
  APPROVED
  REJECTED
  ARCHIVED
}

enum AiSessionType {
  CAMPAIGN_PLANNER
  CREATIVE_GEN
  AUDIENCE_BUILDER
  BUDGET_OPTIMIZER
  REPORT
}

enum AudienceType {
  LOOKALIKE
  INTEREST
  RETARGETING
  CUSTOM
  BEHAVIORAL
  SAVED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  plan      PlanType @default(FREE)
  createdAt DateTime @default(now())

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  aiSessions       AiSession[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecider")
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String?  @unique
  industry     String?
  companySize  String?
  /// Agency profile + reporting defaults (Settings › General, A14).
  website      String?
  /// IANA time zone for weekly summaries and alert timing; null = UTC.
  timezone     String?
  /// 1 = Monday, 0 = Sunday (weekly summaries).
  weekStartsOn Int      @default(1)
  /// C1: Media buyers' budget increases above this % wait for an owner. Null = off.
  approvalBudgetPct Int?   @default(20)
  /// C1: what happens to an approval nobody acted on within 24 hours.
  approvalTimeout ApprovalTimeout @default(KEEP)
  /// C14: the most a safety rule may cut a campaign's daily budget in one day (%).
  safetyMaxCutPct Int     @default(20)
  /// C13: auto-apply only moves a daily budget by at most this % (once per campaign per day).
  autoApplyMaxPct Int     @default(15)
  /// C13/C14: stops every automatic change (safety rules, auto-apply) until switched back on.
  automationPaused Boolean @default(false)
  ownerId      String
  plan         PlanType @default(FREE)
  createdAt    DateTime @default(now())

  /// Reserved for the deferred auto-optimize mode (auto-applying budget
  /// recommendations). Dormant for now — no cron consumes these yet.
  autoOptimize           Boolean    @default(false)
  autoOptimizeThreshold  Decimal    @default(2.0) @db.Decimal(6, 2)
  /// Last time AI insights were generated for this workspace (1-hour refresh
  /// gate lives off this).
  lastInsightGeneratedAt DateTime?
  /// Platforms the background sync skips for this workspace (Connections › Auto-sync off, A13).
  autoSyncOff            Platform[] @default([])

  owner                 User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members               WorkspaceMember[]
  pendingConnections    PendingConnection[]
  notificationLogs      NotificationLog[]
  adAccounts            AdAccount[]
  campaigns             Campaign[]
  creatives             Creative[]
  aiSessions            AiSession[]
  audiences             Audience[]
  budgetRecommendations BudgetRecommendation[]
  insights              Insight[]
  clients               Client[]
  suggestions           Suggestion[]
  plans                 Plan[]
  changeLogs            ChangeLog[]
  invites               Invite[]
  approvals             ApprovalRequest[]
  alerts                Alert[]
  clientShares          ClientShare[]
  reportSchedules       ReportSchedule[]

  @@index([ownerId])
}

/// An agency's client (a brand the workspace runs ads for). Ad accounts are
/// assigned to a client; campaigns and metrics inherit it through their ad
/// account. Single-brand workspaces get one default client (`isDefault`), and
/// the UI hides the client switcher when there's only one.
/// See docs/DASHBOARD_REDESIGN_PLAN.md (B1).
model Client {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  /// 1–3 letter mark shown in avatars ("LS"). Derived from the name if null.
  short         String?
  /// Free-text vertical shown under the name ("Beauty · DTC").
  vertical      String?
  logoUrl       String?
  /// Monthly spend cap used for pacing, in `currency`. Null = no cap set.
  monthlyBudget Decimal? @db.Decimal(14, 2)
  /// ISO 4217 currency of `monthlyBudget` (defaults to the first account's).
  currency      String?
  /// The auto-created client for single-brand workspaces.
  isDefault     Boolean  @default(false)
  /// C1: every spend change a Media buyer makes for this client waits for an owner.
  askFirst      Boolean  @default(false)
  /// C14 safety rules (opt-in): pause conversion campaigns while the pixel is silent; trim budgets before the monthly cap runs out.
  safetyPixel   Boolean  @default(false)
  safetyCap     Boolean  @default(false)
  /// C13: "Auto-apply small changes" (false = Suggest only).
  autoApply     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccounts   AdAccount[]
  creatives    Creative[]
  audiences    Audience[]
  suggestions  Suggestion[]
  plans        Plan[]
  memberAccess MemberClientAccess[]
  approvals    ApprovalRequest[]
  shares       ClientShare[]
  reportSchedule ReportSchedule?

  @@index([workspaceId])
}

/// A member limited to some clients (plan B6).
model MemberClientAccess {
  id        String   @id @default(cuid())
  memberId  String
  clientId  String
  createdAt DateTime @default(now())

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([memberId, clientId])
  @@index([clientId])
}

/// A pending invitation to join a workspace (plan B6). The link carries
/// `token`; it works for 7 days and only for the invited email.
model Invite {
  id           String        @id @default(cuid())
  workspaceId  String
  email        String
  role         WorkspaceRole
  /// Clients the new member will be limited to (empty = all).
  clientIds    String[]
  token        String        @unique
  invitedById  String?
  status       InviteStatus  @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  emailSentAt  DateTime?
  /// Why the email didn't go out (no email key, Resend error). The link still works.
  emailError   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model WorkspaceMember {
  id            String        @id @default(cuid())
  workspaceId   String
  userId        String
  role          WorkspaceRole @default(ANALYST)
  createdAt     DateTime      @default(now())
  /// Email alert choices per event (Settings › Notifications, A14): { [event]: boolean }. Null = role defaults.
  notifications Json?
  /// C2: when this member last opened the alerts inbox (unread = first seen after this).
  alertsSeenAt  DateTime?

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Clients this member may see. Empty = all clients (client viewers always have some).
  clientAccess MemberClientAccess[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model AdAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  platform        Platform
  accountId       String
  accountName     String
  // ISO 4217 code captured from the ad platform at OAuth / sync time. Used
  // to render all money values (budget, spend, revenue) in the account's
  // native currency instead of forcing USD display.
  currency        String?
  // IANA tz name (e.g. "Asia/Karachi") for displaying campaign timestamps
  // in the account's local time. Display-only today.
  timezone        String?
  /// The platform's minimum daily budget for this account, in the account's
  /// own currency (e.g. 1.00 = PKR 1.00). Captured from Meta on each sync and
  /// used to ground budget recommendations without any FX conversion. Null
  /// until first sync.
  minDailyBudget  Float?
  /// Meta account_status (1 = active, 2 = disabled, 3 = unsettled, 7 = pending
  /// risk review, 9 = grace period, 101 = closed…). Used to warn the user when
  /// their ad account can't run ads. Null until first sync.
  accountStatus   Int?
  /// Last Meta health-check report (MetaHealthReport JSON) + when it ran. Lets
  /// the UI show connection health without re-running all checks every load.
  metadata        Json?
  lastHealthCheck DateTime?
  accessToken     String
  refreshToken    String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  /// Timestamp of the last successful platform sync. Drives the "Last synced"
  /// label and lets the scheduler skip recently-synced accounts. Null = never.
  lastSyncedAt    DateTime?
  /// The agency client this account belongs to. Null = not assigned yet.
  clientId        String?
  /// When the stored token stops working and the user has to reconnect (Meta
  /// long-lived tokens ≈ 60 days, LinkedIn refresh tokens ≈ 1 year). Set at
  /// OAuth time. Null = no known expiry (Google refresh tokens, TikTok).
  tokenExpiresAt  DateTime?
  /// When the first sync pulled 90 days of history (campaign + ad level).
  /// Null = not yet; later syncs only refresh the last 30 days.
  backfilledAt    DateTime?
  /// Archived (A13): hidden from lists, not synced, data kept; restorable.
  archivedAt      DateTime?
  /// Last sync failure (cleared on success), for alerts and the Connections page.
  lastSyncError   String?
  lastSyncErrorAt DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@unique([workspaceId, platform, accountId])
  @@index([workspaceId])
  @@index([clientId])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  adAccountId String
  platform    Platform
  name        String
  status      CampaignStatus @default(DRAFT)
  objective   String
  budget      Decimal        @db.Decimal(12, 2)
  budgetType  BudgetType     @default(DAILY)
  /// Platform's campaign ID. For Meta: numeric string. Null until published.
  externalId  String?
  startDate   DateTime?
  endDate     DateTime?
  targeting   Json?
  /// Range-level unique reach (last 30d) from Meta, refreshed on each sync.
  /// Stored on the campaign — NOT in CampaignMetrics — because reach is
  /// de-duplicated across days, so summing daily rows would overcount. This
  /// snapshot matches the single number Ads Manager shows for the period.
  reach       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Meta publish references — populated when we publish to the platform.
  /// On Meta, every ad needs Campaign + AdSet + AdCreative + Ad. We store
  /// each so we can edit / delete / report on them later. Null until
  /// publish, equivalent for Google/TikTok/LinkedIn once those land.
  externalAdSetId    String?
  externalAdId       String?
  externalCreativeId String?
  /// FB Page that owns the ad's creative (the "sender" identity).
  externalPageId     String?
  /// Timestamp of last successful publish. Lets the UI surface "Published
  /// 2 days ago" without crawling the audit log.
  publishedAt        DateTime?
  /// Last publish error message if the most recent attempt failed. Cleared
  /// on next successful publish.
  publishError       String?
  /// The saved audience (library) this campaign's targeting came from, set by
  /// the New campaign wizard (A9). Null = built by hand or synced.
  audienceId         String?
  /// The saved AI plan (and its version) this draft was created from (A12).
  planId             String?
  planVersion        Int?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccount   AdAccount         @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  metrics     CampaignMetrics[]
  creatives   Creative[]
  suggestions Suggestion[]
  changeLogs  ChangeLog[]
  adSets      AdSet[]
  ads         Ad[]
  audience    Audience?         @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  plan        Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([adAccountId, externalId])
  @@index([workspaceId])
  @@index([adAccountId])
  @@index([status])
  @@index([workspaceId, status])
  @@index([workspaceId, platform])
  @@index([externalId])
  @@index([audienceId])
  @@index([planId])
}

model CampaignMetrics {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  roas        Float    @default(0)
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
}

/// An ad set synced from the platform (plan B4, Meta first). Budgets live
/// here unless the campaign has its own (campaign budget optimisation).
model AdSet {
  id               String         @id @default(cuid())
  campaignId       String
  externalId       String
  name             String
  status           CampaignStatus
  /// The platform's delivery state (e.g. ACTIVE, CAMPAIGN_PAUSED, WITH_ISSUES).
  effectiveStatus  String?
  dailyBudget      Decimal?       @db.Decimal(12, 2)
  lifetimeBudget   Decimal?       @db.Decimal(12, 2)
  optimizationGoal String?
  /// Meta learning phase: LEARNING | SUCCESS | FAIL ("learning limited"). Null = unknown.
  learningStage    String?
  targeting        Json?
  startTime        DateTime?
  endTime          DateTime?
  /// Range-level unique reach and frequency for the last 30 days (not summable from days).
  reach30d         Int            @default(0)
  frequency30d     Float          @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@unique([campaignId, externalId])
  @@index([campaignId])
}

/// An ad synced from the platform, with what its creative shows.
model Ad {
  id                 String         @id @default(cuid())
  campaignId         String
  adSetId            String
  externalId         String
  name               String
  status             CampaignStatus
  effectiveStatus    String?
  creativeExternalId String?
  /// IMAGE | VIDEO | CAROUSEL | UNKNOWN
  format             String         @default("UNKNOWN")
  imageUrl           String?
  headline           String?
  body               String?
  callToAction       String?
  linkUrl            String?
  reach30d           Int            @default(0)
  frequency30d       Float          @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet    AdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  metrics  AdMetrics[]

  @@unique([adSetId, externalId])
  @@index([campaignId])
}

/// Daily ad-level results. Reach is per day (unique within the day), so it
/// can't be summed across days; the 30-day figure is on the Ad.
model AdMetrics {
  id               String   @id @default(cuid())
  adId             String
  date             DateTime
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0)
  spend            Decimal  @default(0) @db.Decimal(12, 2)
  conversions      Int      @default(0)
  revenue          Decimal  @default(0) @db.Decimal(12, 2)
  landingPageViews Int      @default(0)
  addToCart        Int      @default(0)
  updatedAt        DateTime @updatedAt

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([date])
}

model Creative {
  id          String         @id @default(cuid())
  workspaceId String
  campaignId  String?
  name        String
  type        CreativeType
  content     Json
  status      CreativeStatus @default(DRAFT)
  aiGenerated Boolean        @default(false)
  createdAt   DateTime       @default(now())
  /// Owning client. Null = shared library item, shown for every client.
  clientId    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@index([clientId])
}

model AiSession {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  type        AiSessionType
  prompt      String        @db.Text
  response    String        @db.Text
  tokensUsed  Int           @default(0)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([type])
}

/// A saved, reusable Meta targeting spec ("audience"). The `targeting` JSON is
/// the same MetaTargeting shape the publish flow sends to Meta when creating an
/// ad set, so a saved audience can prefill the publish wizard. Meta's own
/// Custom/Saved/Lookalike audiences are NOT stored here — those are fetched
/// live from the platform; this table holds only our own templates.
model Audience {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  type        AudienceType @default(SAVED)
  /// Platforms this audience targets. v1 is always ["META"]; kept as a list
  /// for forward-compat once Google/TikTok targeting lands.
  platforms   Platform[]
  /// MetaTargeting spec (age, geo, interests, custom_audiences, placements…).
  targeting   Json
  aiGenerated Boolean      @default(false)
  /// Best-effort approximate size captured at build time (from Meta interest
  /// audience_size / custom-audience approximate_count). Null when unknown.
  /// Replaced by a real reach range once delivery_estimate lands post-App-Review.
  approxSize  Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// Owning client. Null = shared template, shown for every client.
  clientId    String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([clientId])
}

enum BudgetRecommendationStatus {
  PENDING // generated, not acted on
  APPLIED // user applied all
  PARTIAL // user applied some
  DISMISSED // user dismissed
}

/// A single AI budget-optimization run for a workspace. `analysisData` is the
/// per-campaign performance snapshot we fed the model; `recommendations` is the
/// model's per-campaign output. v1 "apply" updates our DB only (planning) — it
/// does NOT push budget changes to the ad platform yet (see FUTURE_FEATURES).
model BudgetRecommendation {
  id              String                     @id @default(cuid())
  workspaceId     String
  status          BudgetRecommendationStatus @default(PENDING)
  totalBudget     Decimal                    @db.Decimal(14, 2)
  currency        String                     @default("USD")
  analysisData    Json
  recommendations Json
  appliedAt       DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

enum InsightType {
  OPPORTUNITY // green
  WARNING // amber
  OPTIMIZATION // brand/indigo
  ALERT // red
}

enum InsightStatus {
  ACTIVE
  APPLIED
  DISMISSED
  EXPIRED
}

/// An AI-generated, data-driven observation about a workspace's campaigns.
/// Generated by insightsService from real metrics (never hardcoded). "Apply"
/// just marks the recommendation as actioned — the user follows it manually.
model Insight {
  id                String        @id @default(cuid())
  workspaceId       String
  type              InsightType
  status            InsightStatus @default(ACTIVE)
  title             String
  message           String        @db.Text
  impact            String? // e.g. "+$4,200/mo estimated"
  impactType        String? // "revenue" | "cost" | "performance"
  affectedCampaigns Json? // string[] of campaign names
  platform          String?
  priority          Int           @default(0)
  confidence        String        @default("MEDIUM")
  appliedAt         DateTime?
  dismissedAt       DateTime?
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
}

// ─── Suggestions (plan B2) ───────────────────────────────────────────────────
// One model for everything Advertix suggests. Replaces Insight and
// BudgetRecommendation once the Insights and Budgets pages are rebuilt (A10,
// A11); until then those generators write here too. A suggestion either
// carries an executable action (actionType + actionPayload) that Apply really
// performs on the ad platform and Undo reverts, or it is review-only
// (reviewHref).

enum SuggestionStatus {
  OPEN
  APPLIED
  SNOOZED
  DISMISSED
  EXPIRED
}

enum SuggestionSource {
  INSIGHT
  BUDGET_OPTIMIZER
  RULE
}

model Suggestion {
  id            String           @id @default(cuid())
  workspaceId   String
  /// From the campaign's ad account. Null = workspace-wide.
  clientId      String?
  campaignId    String?
  source        SuggestionSource
  /// Id of the Insight / BudgetRecommendation it came from.
  sourceRef     String?
  /// Same key = same suggestion across regenerations ("budget:<campaignId>").
  dedupeKey     String
  /// Card tag: "Budget shift", "Pacing", "Creative fatigue", "Opportunity", …
  kind          String
  title         String
  reason        String           @db.Text
  /// Short, right-aligned impact ("+$3,100 / week").
  impact        String?
  priority      Int              @default(5)
  confidence    String?
  /// "SET_DAILY_BUDGET" | "SET_STATUS". Null = review-only.
  actionType    String?
  actionLabel   String
  doneLabel     String?
  actionPayload Json?
  /// Filled on apply: what Undo restores.
  revertPayload Json?
  /// Where Review goes (also the fallback when the action can't run).
  reviewHref    String?
  status        SuggestionStatus @default(OPEN)
  snoozedUntil  DateTime?
  /// Don't propose this dedupeKey again before this time (set by Undo).
  suppressUntil DateTime?
  appliedAt     DateTime?
  appliedById   String?
  undoneAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, dedupeKey])
  @@index([campaignId])
}

// ─── Saved AI plans (plan B5, used by the AI Planner in A12) ─────────────────
// A plan keeps every version the planner produced, so refinements ("make it
// cheaper", "add TikTok") can be compared and rolled back.

enum PlanStatus {
  DRAFT
  /// Campaigns were created from it.
  USED
  ARCHIVED
}

model Plan {
  id            String     @id @default(cuid())
  workspaceId   String
  clientId      String?
  createdById   String
  title         String
  /// The brief the user typed (first message).
  brief         String     @db.Text
  status        PlanStatus @default(DRAFT)
  /// Number of the newest version (versions are 1, 2, 3, …).
  latestVersion Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  versions  PlanVersion[]
  campaigns Campaign[]

  @@index([workspaceId, updatedAt])
  @@index([clientId])
}

model PlanVersion {
  id        String   @id @default(cuid())
  planId    String
  version   Int
  /// The planner's plan object, as returned by POST /ai/plan-campaign.
  plan      Json
  /// What changed ("Cheaper — $40/day cap"). Optional.
  note      String?
  createdAt DateTime @default(now())

  parent Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
}

// ─── Change log (plan B3) ────────────────────────────────────────────────────
// Append-only record of every change to a campaign: who (a person, an
// Advertix suggestion someone approved, a rule, or a change detected by sync),
// what (before / after), and whether it reached the ad platform. Budget,
// status and name changes can be undone for 7 days; an undo is itself a new
// entry that points back at the one it reverses.

enum ChangeActor {
  /// A person in the workspace.
  USER
  /// An Advertix suggestion, applied by `actorUserId`.
  AI
  /// An automation rule (reserved for automation levels / F2).
  RULE
  /// Detected by sync: changed outside Advertix (e.g. in Ads Manager).
  SYNC
}

model ChangeLog {
  id             String      @id @default(cuid())
  workspaceId    String
  clientId       String?
  /// Null once the campaign is deleted; `campaignName` keeps the label.
  campaignId     String?
  campaignName   String
  actorType      ChangeActor
  /// Who made it, or who approved the suggestion. Null for SYNC.
  actorUserId    String?
  /// "campaign.budget" | "campaign.status" | "campaign.rename" | "campaign.schedule" |
  /// "campaign.targeting" | "campaign.create" | "campaign.duplicate" |
  /// "campaign.publish" | "campaign.delete" | "adset.status" | "adset.budget" | "ad.status"
  /// (ad set / ad entries carry `adSetId` / `adId` and the name in before / after)
  action         String
  /// Human-readable line ("Raised daily budget from $480 to $550").
  summary        String
  before         Json?
  after          Json?
  /// The change was made on the ad platform, not only in Advertix.
  platformPushed Boolean     @default(false)
  suggestionId   String?
  /// Set on an undo entry: the entry it reverses.
  revertOfId     String?
  /// Set on the original entry once it's undone.
  undoneAt       DateTime?
  undoneById     String?
  /// C1: set when an owner approved this change (or it was approved on timeout).
  approvalId     String?
  approvedById   String?
  createdAt      DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([campaignId, createdAt])
  @@index([suggestionId])
}

/// Ad accounts an OAuth connect discovered that aren't in Advertix yet (A13).
/// The Connect dialog lists them; only the ones picked become AdAccounts.
/// Holds the encrypted tokens for 30 minutes.
model PendingConnection {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  platform       Platform
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  /// [{ accountId, accountName, currency, timezone, isActive }]
  accounts       Json
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Email alerts Advertix sent (or tried to), one row per person per alert (A14).
/// The unique key stops the same alert going out twice.
model NotificationLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  /// TOKEN_EXPIRING | SYNC_FAILED | PACING | WEEKLY_SUMMARY | TEST
  event       String
  /// What the alert is about, e.g. "acct_123:2026-10-25" (dedupe).
  key         String
  /// sent | failed
  status      String
  error       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, event, key])
  @@index([workspaceId, createdAt])
}

/// C1: what happens to an approval nobody acted on within 24 hours.
enum ApprovalTimeout {
  KEEP
  APPROVE
  REJECT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  /// Approved, but running the change failed (the platform refused, access changed…).
  FAILED
  /// Withdrawn by the person who asked.
  CANCELLED
}

/// C1: a Media buyer's spend change held for an owner. Approving replays the
/// original API request as the requester, so it runs exactly like a normal change.
model ApprovalRequest {
  id            String         @id @default(cuid())
  workspaceId   String
  clientId      String?
  campaignId    String?
  campaignName  String
  /// The request to run on approval: method + path under /api + JSON body.
  method        String
  path          String
  body          Json?
  /// "Raise daily budget from $400 to $560".
  summary       String
  /// Why it waits: "Raises the budget 40%, above the 20% limit".
  reason        String
  requestedById String
  status        ApprovalStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  /// "manual" | "timeout"
  decidedVia    String?
  note          String?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  requestedBy User      @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?     @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

/// C2 alerts inbox: one row per condition (dedupeKey). Open while the condition
/// holds (lastSeenAt), resolved when it clears; it reopens if it comes back.
model Alert {
  id            String        @id @default(cuid())
  workspaceId   String
  clientId      String?
  campaignId    String?
  adAccountId   String?
  /// ACCESS | ACCOUNT | SYNC_FAILED | PACING | CPA_SPIKE | TRACKING | AUTOMATION
  kind          String
  severity      AlertSeverity
  /// Same condition = same row ("cpa:<campaignId>:<date>").
  dedupeKey     String
  title         String
  detail        String        @db.Text
  /// What the inbox groups it under (campaign, ad account or client name).
  groupLabel    String
  /// One-click fixes: [{ type: "link" | "sync" | "pause" | "undo", label, href?, adAccountId?, campaignId?, changeId? }]
  actions       Json?
  firstSeenAt   DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())
  resolvedAt    DateTime?
  dismissedAt   DateTime?
  dismissedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, resolvedAt])
}

/// C4: a client's read-only portal link (no login). One active link per client;
/// regenerating revokes the old one.
model ClientShare {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String
  /// sha256 of the token in the link (lookup). The token itself is kept
  /// encrypted so the link can be copied again.
  tokenHash     String    @unique
  tokenEnc      String
  /// What the client sees: spend (with CPA and budget pacing), revenue (with ROAS), the campaign list.
  showSpend     Boolean   @default(true)
  showRevenue   Boolean   @default(true)
  showCampaigns Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// C4b: a client's scheduled email report (one per client), sent at 09:00
/// workspace time: WEEKLY on the workspace's first day of the week (the 7
/// days before), MONTHLY on the 1st (the month before).
model ReportSchedule {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String    @unique
  /// WEEKLY | MONTHLY
  frequency     String    @default("WEEKLY")
  recipients    String[]
  showSpend     Boolean   @default(true)
  showRevenue   Boolean   @default(true)
  showCampaigns Boolean   @default(true)
  attachPdf     Boolean   @default(true)
  active        Boolean   @default(true)
  /// Replies go to whoever set it up.
  replyTo       String?
  createdById   String
  /// The period last sent ("2026-10-26" weekly, "2026-10" monthly): once per period.
  lastPeriod    String?
  lastSentAt    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  META
  GOOGLE
  TIKTOK
  LINKEDIN
  YOUTUBE
  SNAPCHAT
  PINTEREST
  X
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum BudgetType {
  DAILY
  LIFETIME
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  TEXT
}

enum CreativeStatus {
  DRAFT
  APPROVED
  REJECTED
  ARCHIVED
}

enum AiSessionType {
  CAMPAIGN_PLANNER
  CREATIVE_GEN
  AUDIENCE_BUILDER
  BUDGET_OPTIMIZER
  REPORT
}

enum AudienceType {
  LOOKALIKE
  INTEREST
  RETARGETING
  CUSTOM
  BEHAVIORAL
  SAVED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  plan      PlanType @default(FREE)
  createdAt DateTime @default(now())

  ownedWorkspaces    Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers   WorkspaceMember[]
  aiSessions         AiSession[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  industry    String?
  companySize String?
  ownerId     String
  plan        PlanType @default(FREE)
  createdAt   DateTime @default(now())

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  adAccounts  AdAccount[]
  campaigns   Campaign[]
  creatives   Creative[]
  aiSessions  AiSession[]
  audiences   Audience[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model AdAccount {
  id           String   @id @default(cuid())
  workspaceId  String
  platform     Platform
  accountId    String
  accountName  String
  // ISO 4217 code captured from the ad platform at OAuth / sync time. Used
  // to render all money values (budget, spend, revenue) in the account's
  // native currency instead of forcing USD display.
  currency     String?
  // IANA tz name (e.g. "Asia/Karachi") for displaying campaign timestamps
  // in the account's local time. Display-only today.
  timezone     String?
  accessToken  String
  refreshToken String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([workspaceId, platform, accountId])
  @@index([workspaceId])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  adAccountId String
  platform    Platform
  name        String
  status      CampaignStatus @default(DRAFT)
  objective   String
  budget      Decimal        @db.Decimal(12, 2)
  budgetType  BudgetType     @default(DAILY)
  /// Platform's campaign ID. For Meta: numeric string. Null until published.
  externalId  String?
  startDate   DateTime?
  endDate     DateTime?
  targeting   Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Meta publish references — populated when we publish to the platform.
  /// On Meta, every ad needs Campaign + AdSet + AdCreative + Ad. We store
  /// each so we can edit / delete / report on them later. Null until
  /// publish, equivalent for Google/TikTok/LinkedIn once those land.
  externalAdSetId   String?
  externalAdId      String?
  externalCreativeId String?
  /// FB Page that owns the ad's creative (the "sender" identity).
  externalPageId    String?
  /// Timestamp of last successful publish. Lets the UI surface "Published
  /// 2 days ago" without crawling the audit log.
  publishedAt       DateTime?
  /// Last publish error message if the most recent attempt failed. Cleared
  /// on next successful publish.
  publishError      String?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccount AdAccount          @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  metrics   CampaignMetrics[]
  creatives Creative[]

  @@unique([adAccountId, externalId])
  @@index([workspaceId])
  @@index([adAccountId])
  @@index([status])
  @@index([workspaceId, status])
  @@index([workspaceId, platform])
  @@index([externalId])
}

model CampaignMetrics {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  roas        Float    @default(0)
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
}

model Creative {
  id           String         @id @default(cuid())
  workspaceId  String
  campaignId   String?
  name         String
  type         CreativeType
  content      Json
  status       CreativeStatus @default(DRAFT)
  aiGenerated  Boolean        @default(false)
  createdAt    DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
}

model AiSession {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  type        AiSessionType
  prompt      String        @db.Text
  response    String        @db.Text
  tokensUsed  Int           @default(0)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([type])
}

/// A saved, reusable Meta targeting spec ("audience"). The `targeting` JSON is
/// the same MetaTargeting shape the publish flow sends to Meta when creating an
/// ad set, so a saved audience can prefill the publish wizard. Meta's own
/// Custom/Saved/Lookalike audiences are NOT stored here — those are fetched
/// live from the platform; this table holds only our own templates.
model Audience {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  type        AudienceType @default(SAVED)
  /// Platforms this audience targets. v1 is always ["META"]; kept as a list
  /// for forward-compat once Google/TikTok targeting lands.
  platforms   Platform[]
  /// MetaTargeting spec (age, geo, interests, custom_audiences, placements…).
  targeting   Json
  aiGenerated Boolean      @default(false)
  /// Best-effort approximate size captured at build time (from Meta interest
  /// audience_size / custom-audience approximate_count). Null when unknown.
  /// Replaced by a real reach range once delivery_estimate lands post-App-Review.
  approxSize  Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, type])
}
